### 05 Upload PNG
POST {{baseUrl}}/api/images
Content-Type: multipart/form-data; boundary=MedVisionBoundary
Accept: application/json
X-CSRF-TOKEN: {{imageCsrf}}

--MedVisionBoundary
Content-Disposition: form-data; name="file"; filename="valid.png"
Content-Type: image/png

< ./fixtures/valid.png
--MedVisionBoundary--

> {%
    client.test("05 Upload PNG", function () {
        client.assert(response.status === 201, "Expected 201, got " + response.status);
    });
    if (response.status === 201) {
        const imageId = response.body.id;
client.assert(
    imageId !== undefined && imageId !== null,
    "Upload response missing image ID"
);
client.global.set("phase5PngId", String(imageId));
client.log("PNG ID saved: " + String(imageId));
client.assert(
    String(client.global.get("phase5PngId")) === String(imageId),
    "PNG ID was not saved correctly"
);
client.log("Saved phase5PngId: " + imageId);
client.assert(response.body.width === 8, "Wrong width");
client.assert(response.body.height === 6, "Wrong height");
client.assert(response.body.mimeType === "image/png", "Wrong MIME");
client.assert(!("storageKey" in response.body), "Storage key exposed");
    }
%}

