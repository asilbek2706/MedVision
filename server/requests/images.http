%}

### 07 List own images
GET {{baseUrl}}/api/images
Accept: application/json

> {%
    client.test("07 List own images", function () {
        client.assert(response.status === 200, "Expected 200, got " + response.status);
    });
    if (response.status === 200) {
        client.assert(
    response.body.items.some(item => item.id === client.global.get("phase5PngId")),
    "Uploaded PNG missing"
);
    }
%}

