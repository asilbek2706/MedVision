### 09 Owner receives image bytes
GET {{baseUrl}}/api/images/{{phase5PngId}}/content
Accept: image/png

> {%
    client.test("09 Owner receives image bytes", function () {
        client.assert(response.status === 200, "Expected 200, got " + response.status);
    });
    if (response.status === 200) {
        client.assert(
    (response.headers.valueOf("Content-Type") || "").includes("image/png"),
    "Wrong content type"
);
client.assert(
    (response.headers.valueOf("Cache-Control") || "").includes("no-store"),
    "Private image must not be cached"
);
    }
%}

### 10 Fake image rejected
POST {{baseUrl}}/api/images
Content-Type: multipart/form-data; boundary=MedVisionBoundary
Accept: application/json
X-CSRF-TOKEN: {{imageCsrf}}

--MedVisionBoundary
Content-Disposition: form-data; name="file"; filename="fake.png"
Content-Type: image/png

< ./fixtures/fake.png
--MedVisionBoundary--

> {%
    client.test("10 Fake image rejected", function () {
        client.assert(response.status === 415, "Expected 415, got " + response.status);
    });
    if (response.status === 415) {
        client.assert(response.body.code === "UNSUPPORTED_IMAGE", "Wrong code");
    }
%}

### 11 Oversized file rejected
POST {{baseUrl}}/api/images
Content-Type: multipart/form-data; boundary=MedVisionBoundary
Accept: application/json
X-CSRF-TOKEN: {{imageCsrf}}

--MedVisionBoundary
Content-Disposition: form-data; name="file"; filename="large.png"
Content-Type: image/png

< ./fixtures/large.png
--MedVisionBoundary--

> {%
    client.test("11 Oversized file rejected", function () {
        client.assert(response.status === 413, "Expected 413, got " + response.status);
    });
    if (response.status === 413) {
        client.assert(response.body.code === "PAYLOAD_TOO_LARGE", "Wrong code");
    }
%}

