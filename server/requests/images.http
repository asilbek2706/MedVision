@baseUrl = http://localhost:18080
@testPassword = MedVisionTest2026!


### 01 Get CSRF
GET {{baseUrl}}/api/auth/csrf
Accept: application/json

> {%
    client.test("01 Get CSRF", function () {
        client.assert(response.status === 200, "Expected 200, got " + response.status);
    });
    if (response.status === 200) {
        client.global.set("imageCsrf", response.body.token);
const tag = Date.now();
client.global.set("imageEmailA", "image-a-" + tag + "@example.test");
client.global.set("imageEmailB", "image-b-" + tag + "@example.test");
    }
%}

