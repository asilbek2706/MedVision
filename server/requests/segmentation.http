@baseUrl = http://localhost:18080
@testPassword = MedVisionTest2026!

### 01 Get CSRF and generate test email
GET {{baseUrl}}/api/auth/csrf
Accept: application/json

> {%
    client.test("CSRF available", function () {
        client.assert(response.status === 200, "Expected 200");
    });
    if (response.status === 200) {
        client.global.set("segCsrf", response.body.token);
        client.global.set(
            "segEmail",
            "seg-" + Date.now() + "@example.test"
        );
    }
%}

### 02 Register segmentation test user
POST {{baseUrl}}/api/auth/register
Content-Type: application/json
Accept: application/json
X-CSRF-TOKEN: {{segCsrf}}

{
  "name": "Segmentation Test",
  "email": "{{segEmail}}",
  "password": "{{testPassword}}"
}

> {%
    client.test("Registration succeeds", function () {
        client.assert(response.status === 201, "Expected 201");
    });
%}

### 03 Login
POST {{baseUrl}}/api/auth/login
Content-Type: application/json
Accept: application/json
X-CSRF-TOKEN: {{segCsrf}}

{
  "email": "{{segEmail}}",
  "password": "{{testPassword}}"
}

> {%
    client.test("Login succeeds", function () {
        client.assert(response.status === 200, "Expected 200");
    });
%}

### 04 Refresh CSRF after login
GET {{baseUrl}}/api/auth/csrf
Accept: application/json

> {%
    client.test("Fresh CSRF", function () {
        client.assert(response.status === 200, "Expected 200");
    });
    if (response.status === 200) {
        client.global.set("segCsrf", response.body.token);
    }
%}

### 05 Upload test PNG
POST {{baseUrl}}/api/images
Content-Type: multipart/form-data; boundary=MedVisionBoundary
Accept: application/json
X-CSRF-TOKEN: {{segCsrf}}

--MedVisionBoundary
Content-Disposition: form-data; name="file"; filename="valid.png"
Content-Type: image/png

< ./fixtures/valid.png
--MedVisionBoundary--

> {%
    client.test("PNG upload succeeds", function () {
        client.assert(response.status === 201, "Expected 201");
    });
    if (response.status === 201) {
        client.global.set("segImageId", response.body.id);
    }
%}

### 06 Execute OTSU segmentation
POST {{baseUrl}}/api/images/{{segImageId}}/analyses
Content-Type: application/json
Accept: application/json
X-CSRF-TOKEN: {{segCsrf}}

{
  "algorithm": "OTSU",
  "blurKernelSize": 5,
  "invert": false
}

> {%
    client.test("Segmentation succeeds", function () {
        client.assert(response.status === 201, "Expected 201");
    });
    if (response.status === 201) {
        client.assert(
            response.body.status === "COMPLETED",
            "Analysis not completed"
        );
        client.assert(
            response.body.foregroundRatio >= 0 &&
            response.body.foregroundRatio <= 1,
            "Invalid foreground ratio"
        );
        client.assert(
            !("maskKey" in response.body),
            "Storage key exposed"
        );
        client.global.set("segAnalysisId", response.body.id);
    }
%}

### 07 Get analysis detail
GET {{baseUrl}}/api/analyses/{{segAnalysisId}}
Accept: application/json

> {%
    client.test("Analysis detail available", function () {
        client.assert(response.status === 200, "Expected 200");
        client.assert(
            response.body.status === "COMPLETED",
            "Expected COMPLETED"
        );
    });
%}

### 08 Download binary mask
GET {{baseUrl}}/api/analyses/{{segAnalysisId}}/mask
Accept: image/png

> {%
    client.test("Mask PNG available", function () {
        client.assert(response.status === 200, "Expected 200");
        client.assert(
            (response.headers.valueOf("Content-Type") || "")
                .includes("image/png"),
            "Expected PNG"
        );
    });
%}

### 09 Download overlay
GET {{baseUrl}}/api/analyses/{{segAnalysisId}}/overlay
Accept: image/png

> {%
    client.test("Overlay PNG available", function () {
        client.assert(response.status === 200, "Expected 200");
        client.assert(
            (response.headers.valueOf("Content-Type") || "")
                .includes("image/png"),
            "Expected PNG"
        );
    });
%}

### 10 Invalid blur kernel rejected
POST {{baseUrl}}/api/images/{{segImageId}}/analyses
Content-Type: application/json
Accept: application/json
X-CSRF-TOKEN: {{segCsrf}}

{
  "algorithm": "OTSU",
  "blurKernelSize": 4,
  "invert": false
}

> {%
    client.test("Even blur kernel rejected", function () {
        client.assert(response.status === 400, "Expected 400");
        client.assert(
            response.body.code === "INVALID_BLUR_KERNEL",
            "Wrong error code"
        );
    });
%}
