{
  "email": "{{limitTestEmail}}",
  "password": "Wrong-Password-2026!"
}

> {%
    client.test("Login limit attempt 11", function () {
        client.assert(response.status === 429, "Unexpected HTTP status");
        client.assert(response.body.code === "LOGIN_RATE_LIMITED", "Wrong error code");
    });
%}

